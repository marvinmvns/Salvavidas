# Processing Mode: local, api_fast, api_premium
PROCESSING_MODE=local

# Target language for translation
TARGET_LANGUAGE=en

# Source language (auto-detect if empty)
SOURCE_LANGUAGE=

# API Keys - STT
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
GOOGLE_CLOUD_CREDENTIALS_PATH=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# API Keys - Translation
DEEPL_API_KEY=

# API Keys - LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# API Keys - TTS
ELEVENLABS_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Performance Settings
# Latency priority: realtime, balanced, quality
LATENCY_PRIORITY=realtime

# Enable speaker identification
ENABLE_SPEAKER_ID=true

# Enable response suggestions
ENABLE_SUGGESTIONS=true

# Audio settings
SAMPLE_RATE=16000
CHUNK_SIZE=1024
CHANNELS=1

# Local model paths
WHISPER_MODEL=base
LLAMA_MODEL_PATH=./models/llama-2-7b-chat.Q4_K_M.gguf
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-pt

# Streaming settings
ENABLE_STREAMING=true
STREAM_CHUNK_MS=100
